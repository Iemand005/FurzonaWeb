{
	"scripts": {
		"clean": "rimraf dist",
		"build:js": "babel . -d dist --ignore \"node_modules/**\",\"dist/**\"",
		"build:assets": "cpy \"**/*.{html,css}\" dist --parents --ignore=\"node_modules/**\" --ignore=\"dist/**\"",
		"build:polyfill": "node -e \"const fs=require('fs'); fs.copyFileSync('node_modules/core-js-bundle/minified.js', 'dist/polyfill.js'); fs.copyFileSync('node_modules/whatwg-fetch/dist/fetch.umd.js', 'dist/fetch-polyfill.js'); fs.copyFileSync('node_modules/url-polyfill/url-polyfill.min.js', 'dist/url-polyfill.js'); fs.copyFileSync('node_modules/url-search-params-polyfill/index.js', 'dist/url-search-params-polyfill.js')\"",
		"build": "npm run clean && npm run build:js && npm run build:assets && npm run build:polyfill"
	},
	"devDependencies": {
		"@babel/cli": "^8.0.4",
		"@babel/core": "^8.0.1",
		"@babel/preset-env": "^8.0.2",
		"babel-plugin-polyfill-corejs3": "^1.0.0",
		"core-js": "^3.50.0",
		"core-js-bundle": "^3.50.0",
		"cpy-cli": "^7.0.0",
		"rimraf": "^6.1.3",
		"url-polyfill": "^1.1.14",
		"whatwg-fetch": "^3.6.20"
	},
	"dependencies": {
		"url-search-params-polyfill": "^8.2.5"
	}
}
