{
	"compilerOptions": {
		"target": "es6",
		"lib": ["ES6", "DOM"],
		"checkJs": true,
		"allowJs": true,
		"strict": true,
		"typeRoots": [
			"./Types",
			"./node_modules/@types"
		]
	},
	"ignoreDeprecations": "6.0",
	"include": [
		"./Scripts/WebGraphics",
		"*.d.ts",
		"**/*.js",
		"**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
